<project name="metabnf-smoke" default="smoke" basedir=".">
  <property environment="env" />
  <property name="mps.home" value="${env.MPS_HOME}" />
  <property name="repo.root" location="../.." />
  <property name="antlr.jar" location="${repo.root}/build/antlr/antlr4-4.13.2-complete.jar" />
  <condition property="python.executable" value="python" else="python3">
    <os family="windows" />
  </condition>
  <available file="${mps.home}/lib/ant/lib/ant-mps.jar" property="mps.available" />
  <fail unless="mps.available" message="Set MPS_HOME or -Dmps.home to an MPS 2026.1 installation." />

  <taskdef resource="jetbrains/mps/build/ant/antlib.xml">
    <classpath>
      <fileset dir="${mps.home}/lib/ant/lib" includes="*.jar" />
    </classpath>
  </taskdef>

  <target name="prepare">
    <tempfile property="smoke.dir" destdir="${java.io.tmpdir}" prefix="metabnf-smoke-" />
    <property name="smoke.project" location="${smoke.dir}/project" />
    <echo message="Smoke-test artifacts: ${smoke.dir}" />
    <mkdir dir="${smoke.dir}/tmp" />
    <copy todir="${smoke.project}">
      <fileset dir="${repo.root}">
        <include name=".mps/*.xml" />
        <include name="languages/**/*.mpl" />
        <include name="languages/**/*.msd" />
        <include name="languages/**/*.mps" />
        <include name="solutions/**/*.msd" />
        <include name="solutions/**/*.mps" />
        <exclude name=".mps/workspace.xml" />
        <exclude name="**/source_gen/**" />
        <exclude name="**/source_gen.caches/**" />
        <exclude name="**/classes_gen/**" />
      </fileset>
    </copy>
    <copy file="${basedir}/smoketest.msd" todir="${smoke.dir}/harness" />
  </target>

  <target name="core" depends="prepare">
    <echo message="Building the two core languages and their generation plan from clean sources." />
    <mps.make mpsHome="${mps.home}" failOnError="true">
      <repository>
        <modules dir="${smoke.project}/languages" />
        <modules dir="${smoke.project}/solutions" />
      </repository>
      <module file="${smoke.project}/languages/mbnf/mbnf.mpl" />
      <module file="${smoke.project}/languages/metabnf.aspectgen/metabnf.aspectgen.mpl" />
      <module file="${smoke.project}/solutions/GenPlan/Genplan.msd" />
      <jvmargs>
        <arg value="-Xmx2g" />
        <arg value="-ea" />
        <arg value="-Djava.io.tmpdir=${smoke.dir}/tmp" />
        <arg value="-Didea.config.path=${smoke.dir}/config" />
        <arg value="-Didea.system.path=${smoke.dir}/system" />
        <arg value="-Didea.log.path=${smoke.dir}/log" />
      </jvmargs>
    </mps.make>
  </target>

  <target name="compile-harness" depends="prepare">
    <mkdir dir="${smoke.dir}/harness/classes" />
    <javac srcdir="${basedir}" destdir="${smoke.dir}/harness/classes"
           includes="MetaBnfSmokeTest.java,UsabilityAnnotationsTest.java,UsabilityEditorsTest.java,BundledGrammarImportTest.java,metabnf/rascal/GrammarModelImporter.java,metabnf/rascal/GrammarTools.java" includeantruntime="false" encoding="UTF-8"
           fork="true" executable="${java.home}/bin/javac">
      <src path="${repo.root}/mps-plugin/src/main/java" />
      <classpath>
        <fileset dir="${mps.home}/lib" includes="*.jar" />
        <fileset dir="${mps.home}/lib/ant/lib" includes="*.jar" />
        <fileset dir="${mps.home}/lib/mpsant" includes="*.jar" />
        <fileset dir="${mps.home}/plugins/mps-core/lib" includes="*.jar" />
        <pathelement location="${smoke.project}/languages/mbnf/classes_gen" />
      </classpath>
    </javac>
  </target>

  <target name="antlr-fixture" depends="prepare">
    <exec executable="${python.executable}" failonerror="true">
      <env key="JAVA_HOME" value="${java.home}" />
      <arg value="${repo.root}/antlr-bridge/bridge.py" />
      <arg value="grammar" />
      <arg value="--antlr-jar" />
      <arg value="${antlr.jar}" />
      <arg value="--grammar" />
      <arg value="${repo.root}/tests/antlr-bridge/Mini.g4" />
      <arg value="--start" />
      <arg value="program" />
      <arg value="--model-name" />
      <arg value="AntlrImportFixture" />
      <arg value="--output" />
      <arg value="${smoke.project}/languages/mbnf/sandbox/models/AntlrImportFixture.mps" />
    </exec>
    <exec executable="${python.executable}" failonerror="true">
      <env key="JAVA_HOME" value="${java.home}" />
      <arg value="${repo.root}/antlr-bridge/bridge.py" />
      <arg value="text" />
      <arg value="--antlr-jar" />
      <arg value="${antlr.jar}" />
      <arg value="--grammar" />
      <arg value="${repo.root}/tests/antlr-bridge/DemoText.g4" />
      <arg value="--start" />
      <arg value="program" />
      <arg value="--input-text" />
      <arg value="${repo.root}/tests/antlr-bridge/program.txt" />
      <arg value="--template" />
      <arg value="${smoke.project}/languages/mbnf/sandbox/models/langtest.mps" />
      <arg value="--mapping" />
      <arg value="${repo.root}/tests/antlr-bridge/demo-mapping.json" />
      <arg value="--model-name" />
      <arg value="AntlrTextImportFixture" />
      <arg value="--output" />
      <arg value="${smoke.project}/languages/mbnf/sandbox/models/AntlrTextImportFixture.mps" />
    </exec>
  </target>

  <target name="run-harness" depends="compile-harness,antlr-fixture">
    <delete dir="${smoke.project}/languages/Demo/source_gen" />
    <delete dir="${smoke.project}/languages/Demo/source_gen.caches" />
    <delete dir="${smoke.project}/languages/Demo/classes_gen" />
    <runMPS mpsHome="${mps.home}" solution="df89e477-654a-4695-bb44-4ca739a68e93(metabnf.smoketest)"
            startClass="metabnf.smoketest.MetaBnfSmokeTest" startMethod="run">
      <repository>
        <modules dir="${smoke.project}/languages" />
        <modules dir="${smoke.project}/solutions" />
        <modules dir="${smoke.dir}/harness" />
      </repository>
      <jvmargs>
        <arg value="-Xmx2g" />
        <arg value="-ea" />
        <arg value="-Djava.io.tmpdir=${smoke.dir}/tmp" />
        <arg value="-Dmetabnf.smoke.project=${smoke.project}" />
        <arg value="-Dmetabnf.parser.tools=${parser.tools}" />
        <arg value="-Dmetabnf.smoke.repo=${repo.root}" />
        <arg value="-Didea.config.path=${smoke.dir}/config" />
        <arg value="-Didea.system.path=${smoke.dir}/system" />
        <arg value="-Didea.log.path=${smoke.dir}/log" />
      </jvmargs>
    </runMPS>
  </target>

  <target name="import" depends="core,run-harness" />

  <target name="compile-demo" depends="import">
    <echo message="Rebuilding Demo solely from the imported generated aspects." />
    <delete dir="${smoke.project}/languages/Demo/source_gen" />
    <delete dir="${smoke.project}/languages/Demo/source_gen.caches" />
    <delete dir="${smoke.project}/languages/Demo/classes_gen" />
    <mps.make mpsHome="${mps.home}" failOnError="true">
      <repository>
        <modules dir="${smoke.project}/languages" />
        <modules dir="${smoke.project}/solutions" />
      </repository>
      <module file="${smoke.project}/languages/Demo/Demo.mpl" />
      <jvmargs>
        <arg value="-Xmx2g" />
        <arg value="-ea" />
        <arg value="-Djava.io.tmpdir=${smoke.dir}/tmp" />
        <arg value="-Didea.config.path=${smoke.dir}/config" />
        <arg value="-Didea.system.path=${smoke.dir}/system" />
        <arg value="-Didea.log.path=${smoke.dir}/log" />
      </jvmargs>
    </mps.make>
    <condition property="demo.compiled">
      <and>
        <available file="${smoke.project}/languages/Demo/classes_gen/Demo/structure/StructureAspectDescriptor.class" />
        <available file="${smoke.project}/languages/Demo/classes_gen/Demo/editor/EditorAspectDescriptorImpl.class" />
        <available file="${smoke.project}/languages/Demo/classes_gen/Demo/textGen/TextGenAspectDescriptor.class" />
      </and>
    </condition>
    <fail unless="demo.compiled" message="Demo's generated structure, editor, and textGen descriptors were not compiled." />
  </target>

  <target name="validate-ast" depends="compile-demo">
    <exec executable="${python.executable}" failonerror="true">
      <arg value="${basedir}/../../rascal-bridge/refresh_mps_registry.py" />
      <arg value="--model" />
      <arg value="${smoke.project}/languages/mbnf/sandbox/models/RascalTextImportFixture.mps" />
      <arg value="--structure-model" />
      <arg value="${smoke.project}/languages/Demo/models/structure.mps" />
    </exec>
    <exec executable="${python.executable}" failonerror="true">
      <arg value="${repo.root}/rascal-bridge/refresh_mps_registry.py" />
      <arg value="--model" />
      <arg value="${smoke.project}/languages/mbnf/sandbox/models/AntlrTextImportFixture.mps" />
      <arg value="--structure-model" />
      <arg value="${smoke.project}/languages/Demo/models/structure.mps" />
    </exec>
    <runMPS mpsHome="${mps.home}" solution="df89e477-654a-4695-bb44-4ca739a68e93(metabnf.smoketest)"
            startClass="metabnf.smoketest.MetaBnfSmokeTest" startMethod="validateGeneratedAst">
      <repository>
        <modules dir="${smoke.project}/languages" />
        <modules dir="${smoke.project}/solutions" />
        <modules dir="${smoke.dir}/harness" />
      </repository>
      <jvmargs>
        <arg value="-Xmx2g" />
        <arg value="-ea" />
        <arg value="-Djava.io.tmpdir=${smoke.dir}/tmp" />
        <arg value="-Dmetabnf.smoke.project=${smoke.project}" />
        <arg value="-Didea.config.path=${smoke.dir}/config" />
        <arg value="-Didea.system.path=${smoke.dir}/system" />
        <arg value="-Didea.log.path=${smoke.dir}/log" />
      </jvmargs>
    </runMPS>
  </target>

  <target name="smoke" depends="validate-ast">
    <echo message="MetaBNF smoke test passed. Artifacts: ${smoke.dir}" />
  </target>

  <target name="build-project" depends="core">
    <mps.make mpsHome="${mps.home}" failOnError="true">
      <repository>
        <modules dir="${smoke.project}/languages" />
        <modules dir="${smoke.project}/solutions" />
      </repository>
      <module file="${smoke.project}/languages/Demo/Demo.mpl" />
      <module file="${smoke.project}/languages/Python/Python.mpl" />
      <module file="${smoke.project}/languages/TestLanguage/TestLanguage.mpl" />
      <module file="${smoke.project}/languages/mbnf/sandbox/mbnf.sandbox.msd" />
      <jvmargs>
        <arg value="-Xmx2g" />
        <arg value="-ea" />
        <arg value="-Djava.io.tmpdir=${smoke.dir}/tmp" />
        <arg value="-Didea.config.path=${smoke.dir}/config" />
        <arg value="-Didea.system.path=${smoke.dir}/system" />
        <arg value="-Didea.log.path=${smoke.dir}/log" />
      </jvmargs>
    </mps.make>
  </target>
</project>
